# Copy to .env and fill in real values. The real .env is git-ignored and MUST NEVER
# be committed. This file carries PLACEHOLDERS ONLY — no real secret, no GCP project
# id, no Cloud SQL connection string, no plaintext database password.

# --- Provider seam ---------------------------------------------------------
# local  = self-hosted (local CPU embedder, filesystem object store) — the school
#          deployment default; boots healthy with no GCP credentials.
# minio  = self-hosted with the MinIO object store (enable the `minio` compose profile).
# gcp    = legacy GCP path (Vertex + GCS + Cloud SQL) — not used on the school server.
PROVIDER=local

# --- Database --------------------------------------------------------------
# Postgres credentials consumed by the `db` service and assembled into DATABASE_URL.
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=paperbank
# SQLAlchemy/pg8000 URL the app connects with (host `db` is the compose service name).
DATABASE_URL=postgresql+pg8000://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@db:5432/paperbank

# --- Object store ----------------------------------------------------------
# Filesystem root for served/contributed objects under PROVIDER=local.
OBJECT_STORE_DIR=./data/objects
STORAGE_ROOT=./data/objects
# Only needed under PROVIDER=minio (and the `minio` compose profile).
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=paperbank
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_SECURE=false

# --- Signed download links + tool auth -------------------------------------
# HMAC key for short-lived (~15 min) signed download URLs.
URL_SIGNING_KEY=CHANGE_ME_RANDOM_32_BYTES
DOWNLOAD_BASE_URL=https://bot.example.org
# Bearer token the future Teams/Copilot agent presents to /tool/retrieve.
TOOL_API_TOKEN=CHANGE_ME_TOOL_TOKEN

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
WA_PHONE_NUMBER_ID=CHANGE_ME
WA_ACCESS_TOKEN=CHANGE_ME
WA_APP_SECRET=CHANGE_ME
WA_VERIFY_TOKEN=CHANGE_ME
WA_GRAPH_VERSION=v23.0

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Settings required by the config model (placeholders under PROVIDER=local) ---
# These fields currently have no default in app/config.py, so Settings() needs them
# present even on a local, GCP-free boot. Under PROVIDER=local they are inert — no
# GCS client is constructed and no Vertex/Cloud SQL call is made — so placeholder
# values are safe. Replace only if you actually run PROVIDER=gcp (not on the school
# server). OBJECT_STORE_BUCKET is the provider-neutral alias for the old GCS_BUCKET.
GCP_PROJECT=unused-under-local
CLOUD_SQL_INSTANCE=unused:region:instance
DB_USER=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=paperbank
OBJECT_STORE_BUCKET=paperbank
